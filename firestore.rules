rules_version = '2';
// Lernsprung – in der Firebase-Konsole unter Firestore Database → Regeln einfügen und veröffentlichen.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'ronny.schieler@gmail.com' && request.auth.token.email_verified == true; }
    function inv(id) { return get(/databases/$(db)/documents/invites/$(id)).data; }
    function invExists(id) { return exists(/databases/$(db)/documents/invites/$(id)); }

    // Familien (verschlüsselt). Dokument-ID = Hash des Familien-Codes, nur wer den Code kennt, findet das Dokument.
    match /fam2/{id} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if signedIn() && request.resource.data.v == 2 && request.resource.data.size() < 40
        && ((request.resource.data.inv == 'alt' && request.time < timestamp.date(2027, 1, 1))
            || (invExists(request.resource.data.inv) && inv(request.resource.data.inv).used == null && inv(request.resource.data.inv).blocked != true));
      allow update: if signedIn() && request.resource.data.v == 2 && request.resource.data.inv == resource.data.inv
        && (resource.data.inv == 'alt' || !invExists(resource.data.inv) || inv(resource.data.inv).blocked != true);
      allow delete: if signedIn();
    }
    // Einladungen: ID ist geheim (steht nur im Einladungslink)
    match /invites/{id} {
      allow get: if signedIn();
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && resource.data.used == null && resource.data.blocked != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedAt']));
    }
    // Alter, unverschlüsselter Stand: nur noch lesen und löschen (Umstellung auf fam2)
    match /families/{code} {
      allow get, delete: if signedIn();
      allow create, update: if false;
    }
  }
}
